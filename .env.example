# Copy to .env.local for development. On Vercel, add these under Settings > Environment Variables.

# Admin panel login (/admin). Use a strong password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Long random string used to sign admin sessions.
ADMIN_SECRET=

# Database: Firebase service account JSON on ONE line (Firebase console > Project settings > Service accounts).
FIREBASE_SERVICE_ACCOUNT=

# File uploads: either Vercel Blob (added automatically when you create a Blob store in Vercel) ...
BLOB_READ_WRITE_TOKEN=
# ... or Firebase Storage bucket name (needs the Firebase Blaze plan).
FIREBASE_STORAGE_BUCKET=

# Public site address and Google Analytics measurement id (optional).
NEXT_PUBLIC_SITE_URL=https://theluxeorganization.com
NEXT_PUBLIC_GA_ID=
